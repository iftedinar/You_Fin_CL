# Supabase — get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — get from: platform.openai.com → API Keys
OPENAI_API_KEY=

# Optional: override AI models (defaults: gpt-4o main, gpt-4o-mini for chunk notes)
OPENAI_MODEL=
OPENAI_FAST_MODEL=

# Optional: YouTube transcript fallback — supadata.ai (free tier available)
SUPADATA_API_KEY=

# Optional: higher rate limits for the Jina Reader article fallback — jina.ai
JINA_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
